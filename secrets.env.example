# Copy to secrets.env (gitignored). Never commit the real values.

PAYMENT_API_URL=https://...
# Full URL of the endpoint, e.g. https://<user>-<space>.hf.space/predict
INFERENCE_API_URL=
# Same value as the INFERENCE_API_KEY secret of the inference API Space
INFERENCE_API_KEY=

MLFLOW_TRACKING_URI=https://...
# Read-only token of the MLflow Space (read by the MLflow client itself)
MLFLOW_TRACKING_TOKEN=
MODEL_NAME=fraud-detection-random-forest
MODEL_ALIAS=production

# Application role only (SELECT, INSERT): no admin URL in the processor
DATABASE_URL=postgresql+psycopg2://fraud_detection_app:<password>@localhost:5432/fraud_detection

# Same key as the one used by prepare_training_dataset.py (ml repository),
# otherwise card histories do not match. At least 32 characters.
CARD_ID_HMAC_KEY=

WORKER_INTERVAL_SECONDS=15
DISCORD_FRAUD_WEBHOOK_URL=
